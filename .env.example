# ──────────────────────────────────────────────────────────────
# Mercury Trader — Environment configuration (.env.example)
# Copy to `.env` and fill in real values. Never commit `.env`.
# All values here override `config/*.yaml` at runtime.
# ──────────────────────────────────────────────────────────────

# ── Deployment mode ────────────────────────────────────────────
# live      = execute real orders on MT5
# paper     = simulate fills locally (no broker order sent)
# read_only = collect data + reason, never trade
DEPLOYMENT_MODE=paper

# ── Environment profile ───────────────────────────────────────
# Which broker/symbol-map/database/logs to use (config/environments.yaml).
#   development    paper broker, synthetic data
#   metaquotes_demo  MT5 demo account, paper risk (forward test)
#   exness_live    Exness LIVE — REAL MONEY (trading_enabled must be true)
# Also overridable per-invocation with `mercury --env <name>`.
MERCURY_ENV=development

# ── PostgreSQL ────────────────────────────────────────────────
# Defaults per environment (mercury_development / mercury_demo / mercury_live).
DATABASE_URL=

# ── MetaTrader 5 (Exness) ─────────────────────────────────────
# Generic (used by the `development` profile only if it had an MT5 backend):
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=Exness-MT5
MT5_TERMINAL_PATH=C:\Program Files\MetaTrader 5\terminal64.exe
MT5_ENABLE_TERMINAL_LAUNCH=true

# MetaQuotes-Demo profile credentials (metaquotes_demo):
MT5_LOGIN_DEMO=
MT5_PASSWORD_DEMO=

# Exness LIVE profile credentials (exness_live):
MT5_LOGIN_LIVE=
MT5_PASSWORD_LIVE=

# ── Hermes — LLM providers ────────────────────────────────────
# Pluggable. `provider=hybrid` uses local (Ollama) for fast
# pre-trade checks and external for heavy reasoning.
HERMES_LLM_PROVIDER=hybrid

# External (heavy reasoning) — OpenAI-compatible
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Anthropic (alternative external provider)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-latest

# Local (fast pre-trade checks) — Ollama OpenAI-compatible endpoint
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=llama3.1:8b

# ── Notifications — Telegram ──────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── TradingView webhook signals (optional) ────────────────────
SIGNAL_WEBHOOK_SECRET=change-me
SIGNAL_WEBHOOK_PORT=9100

# ── Logging ───────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_DIR=logs
